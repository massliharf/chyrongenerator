{
  "name": "chyron-studio",
  "homepage": "https://massliharf.github.io/chyrongenerator/",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests *.ts *.js *.json *.md index.html"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/ranchers": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.574.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
